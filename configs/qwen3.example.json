{
  "env": "development",
  "listen": "127.0.0.1:8080",
  "store": {"use": "sqlite", "sqlite": {"path": "niromem.db"}},
  "auth": {"dev": true},
  "blob": {"use": "dir", "dir": {"path": "blobs"}},
  "documents": {"enabled": true, "concurrency": 2},
  "worker": {"inline": true, "concurrency": 1},
  "embedder": {
    "use": "ollama",
    "ollama": {
      "base_url": "http://127.0.0.1:11434",
      "model": "nomic-embed-text",
      "dims": 768,
      "id": "ollama/nomic-embed-text@1",
      "query_prefix": "search_query: ",
      "document_prefix": "search_document: ",
      "keep_alive": "10m",
      "truncate": false
    }
  },
  "knowledge": {
    "mode": "enforced",
    "background_enrichment": true,
    "planner": {
      "use": "ollama",
      "ollama": {
        "base_url": "http://127.0.0.1:11434",
        "model": "qwen3:0.6b",
        "think": false,
        "num_thread": 4,
        "num_ctx": 4096,
        "num_predict": 768
      }
    },
    "profiles": {
      "larger-qwen": {
        "use": "ollama",
        "ollama": {"base_url": "http://127.0.0.1:11434", "model": "qwen3:1.7b", "think": false}
      }
    },
    "max_candidates": 8,
    "max_graph_hops": 2,
    "timeout_ms": 600000,
    "fallback": false
  }
}
